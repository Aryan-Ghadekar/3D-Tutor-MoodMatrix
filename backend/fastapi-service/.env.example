# Copy to .env and fill in. Without a key the service still works, but lecture topics are
# built by plain text extraction instead of AI.
OPENROUTER_API_KEY=your_openrouter_key_here
# OPENROUTER_MODEL=openai/gpt-3.5-turbo
# WHISPER_MODEL=base
# PORT=8001
# CORS_ORIGINS=http://localhost:3000

# Shared secret between the web app's server and this service. When set, every endpoint except /, /health,
# /docs and /classroom/* requires the header "X-API-Key: <value>". Put the same value in
# frontend/.env.local as BACKEND_API_TOKEN. Strongly recommended whenever the port is reachable by others.
# API_TOKEN=generate-a-long-random-string

# Largest accepted upload in megabytes (default 50)
# MAX_UPLOAD_MB=50

# Maximum simultaneous requests to the language model (default 4). Raise it if your provider allows more.
# LLM_CONCURRENCY=4
