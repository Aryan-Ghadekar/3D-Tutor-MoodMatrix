    "/get-lecture-plan": {
      "get": {
        "summary": "Get Lecture Plan",
        "description": "Return the lecture plan for a session/lecture id, or the most recent plan when `latest` is set.",
        "operationId": "get_lecture_plan_get_lecture_plan_get",
        "parameters": [
          {
            "name": "sessionId",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
