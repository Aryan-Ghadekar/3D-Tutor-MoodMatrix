  "components": {
    "schemas": {
      "AnswerAnalysisRequest": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "questions": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Questions"
          },
          "answers": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "type": "array",
            "title": "Answers"
          },
          "student_goal": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Student Goal"
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "questions",
          "answers"
        ],
        "title": "AnswerAnalysisRequest"
      },
      "Body_analyze_lecture_analyze_lecture_post": {
        "properties": {
          "pdf": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pdf"
          },
          "ppt": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Ppt"
          },
          "audio": {
            "anyOf": [
              {
                "type": "string",
                "contentMediaType": "application/octet-stream"
              },
              {
                "type": "null"
              }
            ],
            "title": "Audio"
          }
        },
        "type": "object",
        "title": "Body_analyze_lecture_analyze_lecture_post"
      },
      "Body_generate_dynamic_slide_generate_dynamic_slide_post": {
        "properties": {
          "session_id": {
            "type": "string",
            "title": "Session Id"
          },
          "lecture_plan": {
            "additionalProperties": true,
            "type": "object",
            "title": "Lecture Plan"
          },
          "student_goal": {
            "type": "string",
            "title": "Student Goal",
            "default": "gate"
          },
          "knowledge_state": {
            "additionalProperties": true,
            "type": "object",
            "title": "Knowledge State",
            "default": {}
          },
          "current_topic_index": {
            "type": "integer",
            "title": "Current Topic Index",
            "default": 0
          },
          "action_type": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Action Type",
            "default": "concept_explanation"
          },
          "user_question": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "User Question"
          },
          "context": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Context",
            "default": ""
          }
        },
        "type": "object",
        "required": [
          "session_id",
          "lecture_plan"
        ],
        "title": "Body_generate_dynamic_slide_generate_dynamic_slide_post"
      },
      "ControlRequest": {
        "properties": {
          "action": {
            "type": "string",
            "title": "Action"
          },
          "topicIndex": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Topicindex"
          },
          "mode": {
            "anyOf": [
