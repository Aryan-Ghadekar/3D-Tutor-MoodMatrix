    "/generate-dynamic-slide": {
      "post": {
        "summary": "Generate Dynamic Slide",
        "description": "Generate dynamic slide with AI using three input streams:\n1. Student Goal & Exam Preference\n2. Knowledge State from Quiz Results\n3. Lecture Plan Content",
        "operationId": "generate_dynamic_slide_generate_dynamic_slide_post",
        "requestBody": {
          "content": {
            "application/json": {
