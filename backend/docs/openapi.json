    "/analyze-lecture": {
      "post": {
        "summary": "Analyze Lecture",
        "description": "Turn uploaded material into a lecture plan. Accepts a PDF, a PPTX, an audio file and/or a YouTube link (query parameter yt_link); a transcript on its own is enough. Saves the plan, indexes every chunk for retrieval and returns the plan.",
        "operationId": "analyze_lecture_analyze_lecture_post",
        "parameters": [
          {
            "name": "yt_link",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Yt Link"
            }
          }
        ],
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_analyze_lecture_analyze_lecture_post"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {}
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
