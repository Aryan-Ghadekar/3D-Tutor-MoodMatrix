# Copy to .env.local.

# FastAPI service. The browser calls it only for live-classroom endpoints; everything else goes through this
# server, which is why the API key below never reaches the browser.
# BACKEND_URL=http://localhost:8001
# NEXT_PUBLIC_BACKEND_URL=http://localhost:8001

# Must match API_TOKEN in backend/fastapi-service/.env (leave unset if the backend has no API_TOKEN).
# BACKEND_API_TOKEN=generate-a-long-random-string

# REQUIRED in production (npm start): a long random string used to sign login cookies.
# In development a random one is generated for each run, so you stay logged in only until the server restarts.
# SESSION_SECRET=change-me-to-a-long-random-string
